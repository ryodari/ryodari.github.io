---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;

const siteName = 'beparano.id';
const siteDescription = 'Personal website of Ryodari — Berlin.';
const pageTitle = title ? `${title} — ${siteName}` : siteName;
const pageDescription = description ?? siteDescription;
const ogImage = new URL(image ?? '/images/avatar.JPEG', Astro.site).toString();

const navItems = [
  { label: 'Blog',      href: '/blog' },
  { label: 'Projects',  href: '/projects' },
  { label: 'Contact',   href: '/contact' },
  { label: 'Downloads', href: '/downloads' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={`https://beparano.id${currentPath}`} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="alternate" type="application/rss+xml" title="beparano.id" href="/rss.xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={`https://beparano.id${currentPath}`} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body class="bg-paper text-ink flex flex-col min-h-screen">

    <header class="border-b border-border">
      <nav class="max-w-2xl mx-auto px-6 py-4 flex items-center justify-between gap-6">
        <a
          href="/"
          class="font-mono text-sm font-medium tracking-tight no-underline hover:text-ink-secondary transition-colors"
        >
          be paranoid
        </a>

        <div class="flex items-center gap-5 text-sm">
          {navItems.map(({ label, href }) => {
            const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
            return (
              <a
                href={href}
                class:list={[
                  'no-underline transition-colors',
                  isActive ? 'text-ink font-medium' : 'text-ink-secondary hover:text-ink',
                ]}
              >
                {label}
              </a>
            );
          })}
        </div>
      </nav>
    </header>

    <main class="flex-1 max-w-2xl mx-auto w-full px-6 py-12">
      <slot />
    </main>

    <footer class="border-t border-border mt-auto">
      <div class="max-w-2xl mx-auto px-6 py-6 flex items-center justify-between text-xs text-ink-tertiary">
        <span>© {new Date().getFullYear()} Ryodari</span>
        <div class="flex gap-4">
          <a
            href="https://github.com/ryodari/ryodari.github.io"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-ink transition-colors no-underline"
          >
            Source on GitHub
          </a>
          <span>Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">Astro</a></span>
        </div>
      </div>
    </footer>

  </body>
</html>
